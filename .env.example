# Облачные LLM-провайдеры (ключи НЕ попадают в браузер — проксируются через /api/llm)
# OpenAI (платный): https://platform.openai.com
OPENAI_API_KEY=
# Groq (бесплатный): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (бесплатный): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek (бесплатный, второй ИИ-советник): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Модель веб-поиска (Grounding with Google Search): gemini-3.6-flash, фолбэк gemini-2.5-flash
GEMINI_SEARCH_MODEL=

# Локальные провайдеры (без ключей)
# Ollama: https://ollama.com (запусти: ollama pull qwen3:8b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Локальная генерация изображений: ComfyUI + SDXL-Turbo
# (scripts/setup-local.mjs скачивает и настраивает всё сам)
COMFY_URL=http://127.0.0.1:8188
COMFY_CHECKPOINT=sd_xl_turbo_1.0_fp16.safetensors

# Телеграм-бот (npm run bot) — long-polling к локальному серверу
# Получить токен: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Разрешённые Telegram user-id (через запятую). Пусто = отвечать всем.
TELEGRAM_ALLOWED_IDS=
# Базовый URL веб-приложения (по умолчанию http://localhost:3000)
ULTRON_SERVER=http://localhost:3000
