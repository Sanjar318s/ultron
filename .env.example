# Облачные LLM-провайдеры (ключи НЕ попадают в браузер — проксируются через /api/llm)
# OpenAI (платный): https://platform.openai.com
OPENAI_API_KEY=
# Groq (бесплатный): https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (бесплатный): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek (бесплатный, второй ИИ-советник): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Модель веб-поиска (Grounding with Google Search): gemini-3.6-flash, фолбэк gemini-2.5-flash
GEMINI_SEARCH_MODEL=

# Локальные провайдеры (без ключей)
# Ollama: https://ollama.com (запусти: ollama pull qwen3:8b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Живой веб-поиск: self-hosted OpenSERP OSS (MIT, без ключей)
# Скачать: github.com/karust/openserp/releases → openserp-windows-amd64-*.tgz
# Запустить: openserp.exe serve -p 7000 (browser-режим; Chrome/Edge обязателен)
# Пустой OPENSERP_ENGINE = мульти-движок (mega mode=any), иначе single-engine
OPENSERP_BASE_URL=http://127.0.0.1:7000
OPENSERP_ENGINE=
OPENSERP_LIMIT=8
OPENSERP_EXTRACT=3
OPENSERP_REGION=

# Локальная генерация изображений: ComfyUI + RealVisXL V5.0 + 4x-UltraSharp апскейл
# (scripts/setup-local.mjs скачивает и настраивает всё сам)
COMFY_URL=http://127.0.0.1:8188
COMFY_CHECKPOINT=RealVisXL_V5.0_fp16.safetensors
# Апскейлер: итоговое изображение 2× базового (1024 → 2048)
COMFY_UPSCALE_MODEL=4x-UltraSharp.pth

# GitHub (используется ботом для /git и автономией)
GITHUB_TOKEN=

# Телеграм-бот (npm run bot) — long-polling к локальному серверу
# Получить токен: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Username владельца (полный админ-доступ: файлы, shell, git, одобрение автономии)
TELEGRAM_OWNER_USERNAME=
# Числовой chat ID владельца (для серверных уведомлений: авто-деплой алгоритмов)
# Узнать: напишите боту /id
TELEGRAM_OWNER_CHAT_ID=
# Дополнительные допущенные username (через запятую) — только общение с ассистентом
TELEGRAM_ALLOWED_USERNAMES=
# Базовый URL веб-приложения (по умолчанию http://localhost:3000)
ULTRON_SERVER=http://localhost:3000
